  grossSalary     Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  netSalary       Decimal @default(0) @db.Decimal(12, 2)

  // payment
  paymentStatus String    @default("PENDING") // PENDING | PAID
  paymentDate   DateTime?
  paymentHeadId String? // bank/cash party paid from
  /** amount settled from THIS screen; voucher settlements are counted live */
  paidAmount    Decimal   @default(0) @db.Decimal(12, 2)
  /** auto PAY-<seq>; the outstanding reference when refNo is blank */
  voucherNo     String?
  refNo         String?
  remarks       String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([firmId, fyId, partyId, month])
  @@index([tenantId, partyId])
}

// ============ OFFICE INCOME & EXPENSE ============
// Office income/expense entries with automatic double-entry ledger posting
// (expense/income head ↔ bank/cash, routed via the supplier/party ledger when
// one is selected). refNo is a free alphanumeric external document reference
// (bill / invoice / receipt / challan / LR no) echoed into every ledger entry.
model OfficeTransaction {
  id        String   @id @default(cuid())
  tenantId  String
  firmId    String
  fyId      String
  voucherNo String // auto: OEX-<seq> (expense) / OIN-<seq> (income)
  date      DateTime
  txnType   String // INCOME | EXPENSE
  headId    String // AccountHead (kind INCOME / EXPENSE)
  partyId   String? // supplier / party — optional
  paymentMode String? // CASH | BANK — blank = on credit, settle later via voucher
  bankPartyId String? // bank/cash account (Party BANK|CASH); required when paymentMode set
  amount     Decimal @default(0) @db.Decimal(14, 2)
  gstPct     Decimal @default(0) @db.Decimal(5, 2) // informational
  gstAmount  Decimal @default(0) @db.Decimal(12, 2) // informational, included in amount
  refNo      String? // external reference — editable, alphanumeric, no format
  remarks    String?
  attachmentPath String?

  lines OfficeTxnLine[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([firmId, fyId, voucherNo])
  @@index([tenantId, firmId, fyId, txnType])
  @@index([tenantId, partyId])
}

// One bill, many heads: an optional head-wise split of an office bill (spare
// parts + repair labour on one invoice). When present, the ledger debits each
// line's head; supplier/bank legs stay on the bill total.
// TDS threshold monitoring: sections carry the head mapping (a head belongs to
// at most one section); deductions record what was actually cut so the monitor
// can show only the incremental amount still to deduct.
model TdsSection {
  id              String    @id @default(cuid())
  tenantId        String
  code            String // current section code (new Income Tax Act numbering)
  oldCode         String? // legacy code (194Q / 194C ...) shown as a hint
  name            String
  annualLimit     Decimal   @default(0) @db.Decimal(14, 2)
  singleBillLimit Decimal   @default(0) @db.Decimal(14, 2) // 0 = not applicable
  rateIndividual  Decimal   @default(0) @db.Decimal(5, 2) // PAN 4th letter P/H
  rateCompany     Decimal   @default(0) @db.Decimal(5, 2) // everyone else
  // EXCESS = TDS only on the amount above the annual limit (194Q style);
  // FULL = once crossed, TDS on the whole year's amount (194C style)
  basis           String    @default("FULL")
  headIds         String[]  @default([]) // connected expense AccountHead ids
  // freight TDS (chalan / broker slip / hire) has no expense head — these
  // module tags label it in the TDS Payable report ONLY (never the monitor)
  moduleRefs      String[]  @default([]) // CHALAN | BROKER_SLIP | HIRE

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
}

model TdsDeduction {
  id        String   @id @default(cuid())
  tenantId  String
  firmId    String
  fyId      String
  partyId   String
  sectionId String
  date      DateTime
  amount    Decimal  @default(0) @db.Decimal(14, 2)
  remarks   String?

  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([tenantId, firmId, fyId, partyId, sectionId])
}

model OfficeTxnLine {
  id       String            @id @default(cuid())
  tenantId String
  txnId    String
  txn      OfficeTransaction @relation(fields: [txnId], references: [id], onDelete: Cascade)
  headId   String
  amount   Decimal           @default(0) @db.Decimal(14, 2)
  remarks  String?

  @@index([txnId])
  @@index([tenantId])
}

// ============ VOUCHERS / ACCOUNTS ============

model Voucher {
  id            String           @id @default(cuid())
  tenantId      String
  firmId        String
  fyId          String
  voucherNo     String
  voucherDate   DateTime
  type          VoucherType
  entryType     VoucherEntryType @default(CASH)
  moduleLink    ModuleLink       @default(OTHERS)
  partyId       String?
  vehicleId     String?
  accountHeadId String?
  ledgerPosting String           @default("PARTY") // PARTY | VEHICLE | BOTH
  bankPartyId   String?
  // journal only: credit an income/expense head instead of a party/bank ledger,
  // so a journal can adjust between ANY two ledgers
  creditHeadId  String?
  chequeNo      String?
  chequeDate    DateTime?
  biltyNo       String?
  amount        Decimal          @default(0) @db.Decimal(14, 2)
  tdsAmt        Decimal          @default(0) @db.Decimal(12, 2)
  deduction     Decimal          @default(0) @db.Decimal(12, 2)
  otherAmt      Decimal          @default(0) @db.Decimal(12, 2)
  netAmount     Decimal          @default(0) @db.Decimal(14, 2)
  remarks       String?

  allocations VoucherAllocation[]
  adjustments VoucherAdjustment[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([firmId, fyId, type, voucherNo])
  @@index([tenantId, firmId, fyId, type])
}

// Central reference-based adjustment line (shared engine across receipt /
// payment / journal vouchers). Each line posts automatically to its own
// adjustment ledger head so deducted amounts never remain outstanding.
model VoucherAdjustment {
  id        String  @id @default(cuid())
  tenantId  String
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  adjustmentType String // TDS | SHORTAGE | DAMAGE | PENALTY | ... (extensible)
  referenceType  String // BILL | INVOICE | LR | CHALAN | ADVANCE | LOAN | ...
  referenceNo    String
  referenceDate  DateTime?
  amount         Decimal   @default(0) @db.Decimal(14, 2)
  remarks        String?
  accountHeadId  String? // ledger head the adjustment was posted to

  @@index([tenantId, adjustmentType])
  @@index([tenantId, referenceType, referenceNo])
}

model VoucherAllocation {
  id        String     @id @default(cuid())
  tenantId  String
  voucherId String
  voucher   Voucher    @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  refType   ModuleLink
  refId     String // invoice/chalan/broker slip id
  refNo     String
  billAmt   Decimal    @default(0) @db.Decimal(14, 2)
  tdsPct    Decimal    @default(0) @db.Decimal(5, 2)
  tdsAmt    Decimal    @default(0) @db.Decimal(12, 2)
  deduction Decimal    @default(0) @db.Decimal(12, 2) // shortage
  otherAmt  Decimal    @default(0) @db.Decimal(12, 2) // other deduction
  roundOff  Decimal    @default(0) @db.Decimal(12, 2) // may be negative (paid extra)
  amount    Decimal    @default(0) @db.Decimal(14, 2)
  remarks   String?

  @@index([tenantId, refType, refId])
}

// E-Way Bill monitoring: one row per LR that has been checked or extended.
// prevExpiries keeps every earlier expiry date so a past tab can say
// "Extended Till <new date>" instead of "Expired".
model EwayMonitor {
  id           String    @id @default(cuid())
  tenantId     String
  firmId       String
  fyId         String
  lrId         String    @unique
  checkedAt    DateTime?
  checkedById  String?
  checkedBy    String? // display name, so the grid shows who verified
  prevExpiries Json? // string[] of yyyy-mm-dd calendar dates

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, firmId, fyId])
}

// Extra Work Information (Vehicle module) — pure tracking, no accounting.
// Status is DERIVED: completeDate set => COMPLETED, blank => PENDING.
model VehicleWork {
  id           String    @id @default(cuid())
  tenantId     String
  firmId       String
  fyId         String
  workDate     DateTime
  vehicleId    String
  description  String
  supplier     String? // free text — workshop / mechanic, no master
  completeDate DateTime?
  remarks      String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, firmId, fyId, vehicleId])
  @@index([tenantId, firmId, fyId, workDate])
}

model LedgerEntry {
  id            String    @id @default(cuid())
  tenantId      String
  firmId        String
  fyId          String
  date          DateTime
  partyId       String?
  vehicleId     String?
  accountHeadId String?
  side          EntrySide
  amount        Decimal   @db.Decimal(14, 2)
  refType       String // LR | CHALAN | INVOICE | VOUCHER | BROKER_SLIP | ...
  refId         String
  refNo         String
  narration     String?

  createdAt DateTime @default(now())

  @@index([tenantId, firmId, fyId, partyId, date])
  @@index([tenantId, refType, refId])
}

// ============ POD ============

model Pod {
  id          String        @id @default(cuid())
  tenantId    String
  firmId      String
  fyId        String
  docNo       String
  docDate     DateTime
  sourceType  PodSourceType @default(BOOKING)
  lrId        String?
  lr          Lr?           @relation(fields: [lrId], references: [id])
  refNo       String? // gate pass no / chalan no etc.
  vehicleId   String?
  unloadDate  DateTime?
  ackNo       String?
  actualWt    Decimal?      @db.Decimal(12, 3)
  recWt       Decimal?      @db.Decimal(12, 3)
  shortageWt  Decimal?      @db.Decimal(12, 3)
  poNumber    String?
  gateEntryNo String?
  filePath    String?
  fileSize    Int?
  remarks     String?
  status      String        @default("COMPLETED") // PENDING | COMPLETED

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([firmId, fyId, docNo])
  // one POD per LR — concurrent saves must not create duplicates
  @@unique([lrId])
  @@index([tenantId, lrId])
}

// ============ BROKER SLIP ============

model BrokerSlip {
  id            String    @id @default(cuid())
  tenantId      String
  firmId        String
  fyId          String
  slipNo        String
  slipDate      DateTime
  vehicleId     String?
  transporterId String? // broker/transporter
  loadStationId String?
  destCityId    String?
  consignorId   String?
  consigneeId   String?
  lrNo          String?
  lrDate        DateTime?
  ewbNo         String?
  ewbDate       DateTime?
  productId     String?
  productName   String?
  qty           Decimal   @default(0) @db.Decimal(12, 3)
  actualWt      Decimal   @default(0) @db.Decimal(12, 3)
  chargeWt      Decimal   @default(0) @db.Decimal(12, 3)
  unit          String?
  rateBasis     RateBasis @default(CHARGE_WT)

  // party side (receivable)
  partyId        String?
  pRate          Decimal @default(0) @db.Decimal(12, 2)
  pFreight       Decimal @default(0) @db.Decimal(14, 2)
  pDetention     Decimal @default(0) @db.Decimal(12, 2)
  pOdcAmt        Decimal @default(0) @db.Decimal(12, 2)
  pFineSlip      Decimal @default(0) @db.Decimal(12, 2)
  pOtherAmt      Decimal @default(0) @db.Decimal(12, 2)
  pLdCharge      Decimal @default(0) @db.Decimal(12, 2)
  pShortageAmt   Decimal @default(0) @db.Decimal(12, 2)
  pTdsPct        Decimal @default(0) @db.Decimal(5, 2)
  pTdsAmt        Decimal @default(0) @db.Decimal(12, 2)
  pCommPct       Decimal @default(0) @db.Decimal(5, 2)
  pCommAmt       Decimal @default(0) @db.Decimal(12, 2)
  pMamool        Decimal @default(0) @db.Decimal(12, 2)
  pPaymentCharge Decimal @default(0) @db.Decimal(12, 2)
  pChalanAmt     Decimal @default(0) @db.Decimal(14, 2)
  pNetAmt        Decimal @default(0) @db.Decimal(14, 2)
  pAdvance       Decimal @default(0) @db.Decimal(14, 2)
  pBalance       Decimal @default(0) @db.Decimal(14, 2)
  pRemarks       String?

  // owner/broker side (payable) — auto-copied booking info
  ownerId      String?
  ownerName    String?
  vRate        Decimal @default(0) @db.Decimal(12, 2)
  vFreight     Decimal @default(0) @db.Decimal(14, 2)
  vDetention   Decimal @default(0) @db.Decimal(12, 2)
  vOdcAmt      Decimal @default(0) @db.Decimal(12, 2)
  vFineAmt     Decimal @default(0) @db.Decimal(12, 2)
  vOtherAmt    Decimal @default(0) @db.Decimal(12, 2)
  vLdCharge    Decimal @default(0) @db.Decimal(12, 2)
  vShortageAmt Decimal @default(0) @db.Decimal(12, 2)
  vTdsPct      Decimal @default(0) @db.Decimal(5, 2)
  vTdsAmt      Decimal @default(0) @db.Decimal(12, 2)
  vCommPct     Decimal @default(0) @db.Decimal(5, 2)
  vCommAmt     Decimal @default(0) @db.Decimal(12, 2)
  vMamool      Decimal @default(0) @db.Decimal(12, 2)
  vPaymentAmt  Decimal @default(0) @db.Decimal(12, 2)
  vChalanAmt   Decimal @default(0) @db.Decimal(14, 2)
  vNetAmt      Decimal @default(0) @db.Decimal(14, 2)
  vAdvance     Decimal @default(0) @db.Decimal(14, 2)
  vBalance     Decimal @default(0) @db.Decimal(14, 2)
  vRemarks     String?

  advances Json? // [{side:'P'|'V', type, supplierName, bankName, dieselQty, dieselRate, amount, date, remarks}]

  // trip km
  startKm       Decimal?  @db.Decimal(12, 1)
  unloadDate    DateTime?
  unloadKm      Decimal?  @db.Decimal(12, 1)
  runningKm     Decimal?  @db.Decimal(12, 1)
  tripDays      Int?
  unloadRemarks String?

  // independent rate basis per side (legacy shared `rateBasis` kept above)
  pRateBasis RateBasis @default(CHARGE_WT)
  vRateBasis RateBasis @default(CHARGE_WT)

  // informational only: POD handed over / shared — no workflow dependency
  podAttached Boolean @default(false)
  // POD file uploaded directly from the broker register
  podFilePath   String?
  podFileName   String?
  podUploadDate DateTime?

  // party/broker side balance RECEIVED (mirrors chalan balance payment)
  pPaymentStatus  String    @default("PENDING") // PENDING | RECEIVED
  pRoundOff       Decimal   @default(0) @db.Decimal(12, 2)
  pShortage       Decimal   @default(0) @db.Decimal(12, 2)
  pPaidAmount     Decimal   @default(0) @db.Decimal(12, 2)
  pPaymentDate    DateTime?
  pPaymentHeadId  String? // BANK/CASH party
  pPaymentMode    String?
  pPaymentRemarks String?

  // owner side balance PAID (mirrors chalan balance payment)
  vPaymentStatus  String    @default("PENDING") // PENDING | PAID
  vRoundOff       Decimal   @default(0) @db.Decimal(12, 2)
  vShortage       Decimal   @default(0) @db.Decimal(12, 2)
  vPaidAmount     Decimal   @default(0) @db.Decimal(12, 2)
  vPaymentDate    DateTime?
  vPaymentHeadId  String? // BANK/CASH party
  vPaymentMode    String?
  vPaymentRemarks String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([firmId, fyId, slipNo])
  @@index([tenantId, firmId, fyId])
  @@index([tenantId, vehicleId])
}

// ============ TRIPS & VEHICLE EXPENSES ============

model Trip {
  id          String    @id @default(cuid())
  tenantId    String
  firmId      String
  fyId        String
  tripNo      String
  tripDate    DateTime
  returnDate  DateTime?
  vehicleId   String
  vehicleType String?
  driverId    String? // Driver master link
  driverBalance Decimal @default(0) @db.Decimal(14, 2) // trip driver +/- (posted to DriverSettlement)

  // AdBlue (urea): litres fetched from the stock register; rate entered per
  // trip; amount = qty × rate, treated as driver or company expense
  ureaQty         Decimal @default(0) @db.Decimal(12, 2)
  ureaRate        Decimal @default(0) @db.Decimal(12, 2)
  ureaAmount      Decimal @default(0) @db.Decimal(14, 2)
  ureaExpenseType String  @default("DRIVER") // DRIVER | COMPANY

  // ---- trip settlement (redesigned trip sheet) ----
  calcMethod      String  @default("DIESEL_AVG") // DIESEL_AVG | FIXED | ACTUAL
  fromDate        DateTime? // settlement fetch range
  toDate          DateTime?
  tollExpenseType String  @default("DRIVER") // DRIVER | COMPANY
  tollAmount      Decimal @default(0) @db.Decimal(14, 2) // fetched toll snapshot
  actualDiesel    Decimal @default(0) @db.Decimal(14, 2) // fetched diesel snapshot
  actualAdvance   Decimal @default(0) @db.Decimal(14, 2) // fetched advance snapshot
  loadingKm       Decimal @default(0) @db.Decimal(12, 1)
  unloadingKm     Decimal @default(0) @db.Decimal(12, 1)
  newLoadingKm    Decimal @default(0) @db.Decimal(12, 1)
  dieselAvg       Decimal @default(0) @db.Decimal(8, 2) // km per litre (distance 1)
  dieselAvg2      Decimal @default(0) @db.Decimal(8, 2) // km per litre (distance 2)
  dieselRate      Decimal @default(0) @db.Decimal(8, 2)
  apprDriverAdvance Decimal @default(0) @db.Decimal(14, 2)
  roadBillExp     Decimal @default(0) @db.Decimal(14, 2)
  foodingDays     Decimal @default(0) @db.Decimal(6, 1)
  foodingRate     Decimal @default(0) @db.Decimal(10, 2)
  rtoExp          Decimal @default(0) @db.Decimal(14, 2)
  fixedTripExp    Decimal @default(0) @db.Decimal(14, 2) // FIXED method
  // ACTUAL method — vehicle operating expenses entered on the left side.
  // roadBillExp / foodingDays / foodingRate / rtoExp above are reused; these
  // two cover the remaining heads the method asks for.
  roadExp         Decimal @default(0) @db.Decimal(14, 2) // road expenses
  otherOpExp      Decimal @default(0) @db.Decimal(14, 2) // any other operating expense
  autoFetchedExp  Decimal @default(0) @db.Decimal(14, 2) // snapshot of auto-fetched operating expenses
  actualTotal     Decimal @default(0) @db.Decimal(14, 2) // left side total
  approvedTotal   Decimal @default(0) @db.Decimal(14, 2) // right side total
  grandTotal      Decimal @default(0) @db.Decimal(14, 2) // company vehicle cost

  // going leg
  goingPartyId      String?
  goingSourceCityId String?
  goingDestCityId   String?
  gFreight          Decimal @default(0) @db.Decimal(14, 2)
  gHamali           Decimal @default(0) @db.Decimal(12, 2)
  gOthers           Decimal @default(0) @db.Decimal(12, 2)
  gTotalFreight     Decimal @default(0) @db.Decimal(14, 2)
  gDiesel           Decimal @default(0) @db.Decimal(12, 2)
  gDriverAdvance    Decimal @default(0) @db.Decimal(12, 2)
  gPartyAdvance     Decimal @default(0) @db.Decimal(12, 2)
  gOther            Decimal @default(0) @db.Decimal(12, 2)
  gBankName         String?
  gBalance          Decimal @default(0) @db.Decimal(14, 2)
  gRemarks          String?

  // return leg
  returnPartyId      String?
  returnSourceCityId String?
  returnDestCityId   String?
  rFreight           Decimal @default(0) @db.Decimal(14, 2)
  rHamali            Decimal @default(0) @db.Decimal(12, 2)
  rOthers            Decimal @default(0) @db.Decimal(12, 2)
  rTotalFreight      Decimal @default(0) @db.Decimal(14, 2)
  rDiesel            Decimal @default(0) @db.Decimal(12, 2)
  rDriverAdvance     Decimal @default(0) @db.Decimal(12, 2)
  rPartyAdvance      Decimal @default(0) @db.Decimal(12, 2)
  rDetention         Decimal @default(0) @db.Decimal(12, 2)
  rBankName          String?
  rBalance           Decimal @default(0) @db.Decimal(14, 2)
  rRemarks           String?

  expenses TripExpense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([firmId, fyId, tripNo])
  @@index([tenantId, vehicleId, tripDate])
}

model TripExpense {
  id       String    @id @default(cuid())
  tenantId String
  tripId   String
  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category String // DIESEL | TOLL | DRIVER_BATA | LOADING | UNLOADING | PARKING | POLICE_RTO | MISC
  amount   Decimal   @default(0) @db.Decimal(14, 2)
  remarks  String?
  date     DateTime?

  @@index([tenantId])
}

// Owner Withdrawal: an owner drawing money out of a vehicle's earnings. Not an
// expense — it never touches the vehicle P&L's net; it only reduces the
// vehicle's running balance (lifetime net − lifetime withdrawals). Posts to
// the owner party's ledger (DEBIT) and the paying bank/cash book (CREDIT).
model VehicleWithdrawal {
  id            String    @id @default(cuid())
  tenantId      String
  firmId        String
  fyId          String
  vehicleId     String
  partyId       String // the owner party who took the money
  payPartyId    String // BANK / CASH / CARD party the money left from
  date          DateTime
  amount        Decimal   @db.Decimal(14, 2)
  remarks       String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, firmId, vehicleId])
}

model VehicleExpense {
  id        String   @id @default(cuid())
  tenantId  String
  firmId    String
  fyId      String
  vehicleId String
  date      DateTime
  category  String // TYRE_PURCHASE | TYRE_REPAIR | SERVICE | SPARE_PARTS | REPAIR | INSURANCE | FITNESS | PERMIT | ROAD_TAX | RTO_PAPERS | POLLUTION | DRIVER_SALARY | CLEANER_SALARY | EMI | GPS_RECHARGE | FASTAG_RECHARGE | WASHING | OTHER
  amount    Decimal  @default(0) @db.Decimal(14, 2)
  remarks   String?

  createdAt DateTime @default(now())

  @@index([tenantId, vehicleId, date])
}

// ============ FINANCE & LOAN MANAGEMENT ============
// Loans and non-operational money movement, kept OUT of the transport modules
// but posted through the same voucher + ledger engine everything else uses.

model Loan {
  id        String   @id @default(cuid())
  tenantId  String
  firmId    String
  fyId      String
  loanNo    String
  date      DateTime
  partyId   String // lender (loan taken) or borrower (loan given)
  // BUSINESS_TAKEN | BUSINESS_GIVEN | VEHICLE | PERSONAL_TAKEN | PERSONAL_GIVEN
  loanType  String
  purpose   String?
  vehicleId String? // vehicle loans only; one loan, one vehicle

  amount    Decimal @default(0) @db.Decimal(14, 2)
  // NONE | FLAT | REDUCING — drives the interest suggested on each EMI, which
  // the user may always overwrite
  interestMode String  @default("NONE")
  interestRate Decimal @default(0) @db.Decimal(6, 3) // % per annum

  emiApplicable Boolean   @default(false)
  emiAmount     Decimal   @default(0) @db.Decimal(14, 2)
  emiStartDate  DateTime?
  emiFrequency  String    @default("MONTHLY") // MONTHLY | QUARTERLY | YEARLY
  tenureMonths  Int       @default(0)

  tdsApplicable Boolean @default(false)
  tdsPct        Decimal @default(0) @db.Decimal(5, 2)

  status  String  @default("ACTIVE") // ACTIVE | CLOSED
  closedDate DateTime?
  remarks String?

  emis LoanEmi[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([firmId, fyId, loanNo])
  @@index([tenantId, firmId, fyId, status])
  @@index([tenantId, vehicleId])
}

// One instalment actually paid or received. Nothing is scheduled in advance:
// the register derives the next due date from the last paid EMI, so an
// irregular repayment never leaves a wrong schedule behind.
model LoanEmi {
  id       String   @id @default(cuid())
  tenantId String
  firmId   String
  fyId     String
  loanId   String
  loan     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  emiNo    Int
  dueDate  DateTime?
  payDate  DateTime

  principal Decimal @default(0) @db.Decimal(14, 2)
  interest  Decimal @default(0) @db.Decimal(14, 2)
  penalty   Decimal @default(0) @db.Decimal(12, 2)
  otherAmt  Decimal @default(0) @db.Decimal(12, 2)
  // TDS is deducted from the INTEREST only, never from principal
  tdsAmt    Decimal @default(0) @db.Decimal(12, 2)
  /// principal + interest + penalty + other (before TDS)
  total     Decimal @default(0) @db.Decimal(14, 2)
  /// what actually moved through bank/cash: total - TDS
  netPaid   Decimal @default(0) @db.Decimal(14, 2)

  /// closing instalment that settles whatever is left
  isSettlement Boolean @default(false)

  bankPartyId String
  voucherId   String?
  voucherNo   String?
  remarks     String?

  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([tenantId, loanId, payDate])
  @@index([tenantId, firmId, fyId, payDate])
}

// Money in or out that has nothing to do with transport operations — personal
// transfers, security deposits, miscellaneous receipts. Posts party <-> bank
// and appears in the ledgers, never in an operational report.
model FinanceTxn {
  id        String   @id @default(cuid())
  tenantId  String
  firmId    String
  fyId      String
  voucherNo String
  date      DateTime
  /// RECEIPT (money in) | PAYMENT (money out)
  direction String
  /// PERSONAL | TEMPORARY_LOAN | FAMILY_TRANSFER | SECURITY_DEPOSIT | MISC
  txnType   String
  partyId   String
  amount    Decimal @default(0) @db.Decimal(14, 2)
  entryType String  @default("CASH") // CASH | BANK
  bankPartyId String
  voucherId String?
  remarks   String?

  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@unique([firmId, fyId, voucherNo])
  @@index([tenantId, firmId, fyId, date])
}

// ============ MAINTENANCE SUITE ============

model JobInfo {
  id             String    @id @default(cuid())
  tenantId       String
  firmId         String
  entryDate      DateTime
  vehicleId      String
  garageId       String? // party (supplier)
  jobDescription String?
  jobCompDate    DateTime?
  status         String    @default("PENDING") // DONE | PENDING
  remarks        String?

  createdAt DateTime @default(now())

  @@index([tenantId, vehicleId])
}

model JobEntry {
  id             String     @id @default(cuid())
  tenantId       String
  firmId         String
  fyId           String
  invoiceNo      String
  refNo          String?
  invoiceDate    DateTime
  billType       String     @default("INVOICE") // ESTIMATE | INVOICE
  invType        CashCredit @default(CREDIT)
  supplierId     String?
  vehicleId      String?
  attenderName   String?
  attenderMobile String?
  challanNo      String?
  challanDate    DateTime?
  lines          Json // [{jobHeadId, jobHeadName, description, qty, rate, total, discountPct, taxableValue, gstInc, gstPct, cgstAmt, sgstAmt, igstAmt, amount}]
  currKm         Decimal?   @db.Decimal(12, 1)
  kmInterval     Decimal?   @db.Decimal(12, 1)
  daysInterval   Int?
  remindType     String? // KM | DAYS
  dueDate        DateTime?
  totTaxable     Decimal    @default(0) @db.Decimal(14, 2)
  discAmt        Decimal    @default(0) @db.Decimal(12, 2)
  totCgst        Decimal    @default(0) @db.Decimal(12, 2)
  totSgst        Decimal    @default(0) @db.Decimal(12, 2)
  totIgst        Decimal    @default(0) @db.Decimal(12, 2)
  freight        Decimal    @default(0) @db.Decimal(12, 2)
  others         Decimal    @default(0) @db.Decimal(12, 2)
  tcsPct         Decimal    @default(0) @db.Decimal(5, 2)
  tcsAmt         Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal    @default(0) @db.Decimal(14, 2)
  advance        Decimal    @default(0) @db.Decimal(14, 2)
  balance        Decimal    @default(0) @db.Decimal(14, 2)
  narration      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([firmId, fyId, invoiceNo])
  @@index([tenantId, vehicleId])
}

model Purchase {
  id          String     @id @default(cuid())
  tenantId    String
  firmId      String
  fyId        String
  kind        String     @default("PURCHASE") // PURCHASE | TYRE_SCRAP
  invoiceNo   String
  refNo       String?
  invoiceDate DateTime
  billType    String     @default("INVOICE")
  invType     CashCredit @default(CREDIT)
  buyerId     String?
  consigneeId String?
  transportId String?
  agentId     String?
  transMode   String?
  supplyDate  DateTime?
  supplyPlace String?
  supplyType  String     @default("INVOICE") // INVOICE | EXPORT_INVOICE | BILL_OF_SUPPLY
  challanNo   String?
  challanDate DateTime?
  orderNo     String?
  orderDate   DateTime?
  vehicleId   String?
  driverId    String?
  lines       Json
  opngKm      Decimal?   @db.Decimal(12, 1)
  currKm      Decimal?   @db.Decimal(12, 1)
  clsngKm     Decimal?   @db.Decimal(12, 1)
  wrntyDate   DateTime?
  wrntyDays   Int?
  totTaxable  Decimal    @default(0) @db.Decimal(14, 2)
  discAmt     Decimal    @default(0) @db.Decimal(12, 2)
  totCgst     Decimal    @default(0) @db.Decimal(12, 2)
  totSgst     Decimal    @default(0) @db.Decimal(12, 2)
  totIgst     Decimal    @default(0) @db.Decimal(12, 2)
  freight     Decimal    @default(0) @db.Decimal(12, 2)
  others      Decimal    @default(0) @db.Decimal(12, 2)
  tcsPct      Decimal    @default(0) @db.Decimal(5, 2)
  tcsAmt      Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal  Decimal    @default(0) @db.Decimal(14, 2)
  advance     Decimal    @default(0) @db.Decimal(14, 2)
  balance     Decimal    @default(0) @db.Decimal(14, 2)
  narration   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([firmId, fyId, kind, invoiceNo])
  @@index([tenantId])
}

model TyreInstallation {
