  uninstKm       Decimal?  @db.Decimal(12, 1)
  instDate       DateTime?
  uninstDate     DateTime?
  remarks        String?

  createdAt DateTime @default(now())

  @@index([tenantId, vehicleId])
}

model OpeningStock {
