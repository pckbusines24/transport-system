  invoiceId    String
  invoice      Invoice           @relation(fields: [invoiceId], references: [id])

  // automatic return tracking: when the same invoice appears in a LATER
  // submission, this (earlier) item flips to RETURNED with the new reference
  status           String    @default("SUBMITTED") // SUBMITTED | RETURNED
  resubmittedInId  String?
  resubmittedInNo  String?
  resubmissionDate DateTime?

  @@unique([submissionId, invoiceId])
  @@index([tenantId, invoiceId])
}

// ============ STAFF PAYROLL & ADVANCES ============
// Staff are Party rows (ledgerGroup STAFF); these models add the employment /
