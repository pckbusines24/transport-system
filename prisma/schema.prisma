// Bill Submission v2: one submission covers many invoices, with covering
// letter, acknowledgement, signed-document uploads and automatic
// returned/resubmitted tracking per invoice.
model InvoiceSubmission {
  id             String   @id @default(cuid())
  tenantId       String
  firmId         String
  fyId           String
  submissionNo   String // auto-generated BS-<seq>, unique per firm+FY
  submissionDate DateTime
  partyId        String
  remarks        String?

  // acknowledgement (signed copy received back)
  receivedBy     String?
  designation    String?
  receiverMobile String?
  receivedDate   DateTime?
  receivedTime   String?
  ackRemarks     String?

  // permanently attached documents
  signedLetterPath String?
  ackCopyPath      String?
  supportingPath   String?

  items InvoiceSubmissionItem[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([firmId, fyId, submissionNo])
  @@index([tenantId, firmId, fyId, partyId])
}

model InvoiceSubmissionItem {
  id           String            @id @default(cuid())
  tenantId     String
  submissionId String
