// ============ BILLING ============

model Invoice {
  id            String      @id @default(cuid())
  tenantId      String
  firmId        String
  fyId          String
  kind          InvoiceKind
  invoiceNo     String
  invoiceDate   DateTime
  dueDate       DateTime?
  partyId       String
  lrTypeFilter  LrType?
  remarks       String?
  subject       String?
  bankPartyId   String?
  gstApplicable Boolean     @default(false)
  cgstPct       Decimal     @default(0) @db.Decimal(5, 2)
  cgstAmt       Decimal     @default(0) @db.Decimal(12, 2)
  sgstPct       Decimal     @default(0) @db.Decimal(5, 2)
  sgstAmt       Decimal     @default(0) @db.Decimal(12, 2)
  igstPct       Decimal     @default(0) @db.Decimal(5, 2)
  igstAmt       Decimal     @default(0) @db.Decimal(12, 2)
  tdsPct        Decimal     @default(1) @db.Decimal(5, 2)
  tdsAmt        Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal     @default(0) @db.Decimal(14, 2)
  // paise absorbed rounding netTotal to the whole rupee (print & ledger agree)
  roundOff      Decimal     @default(0) @db.Decimal(12, 2)
  netTotal      Decimal     @default(0) @db.Decimal(14, 2)
  advance       Decimal     @default(0) @db.Decimal(14, 2)
  balance       Decimal     @default(0) @db.Decimal(14, 2)
  totalWt       Decimal     @default(0) @db.Decimal(12, 3)

  // GST invoice extras
  placeOfSupply String?
  supplyDate    DateTime?
  transportMode String?
  reverseCharge Boolean   @default(false)
  sacCode       String? // Service Accounting Code, default 996791 on new bills
  tcsPct        Decimal   @default(0) @db.Decimal(5, 2)
  tcsAmt        Decimal   @default(0) @db.Decimal(12, 2)
  freightExtra  Decimal   @default(0) @db.Decimal(12, 2)
  othersExtra   Decimal   @default(0) @db.Decimal(12, 2)
  narration     String?
  vehicleText   String?

  lrs             InvoiceLr[]
  charges         InvoiceCharge[]
  lines           InvoiceLine[]
  submissions     BillSubmission[]
  submissionItems InvoiceSubmissionItem[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Invoice numbers are unique per firm + FY + kind among ACTIVE (non-deleted)
  // invoices only — enforced by a partial unique index in SQL (Prisma cannot
  // model partial indexes): Invoice_firmId_fyId_kind_invoiceNo_active_key
  // WHERE "deletedAt" IS NULL. Soft-deleted invoice numbers can be reused.
  @@index([firmId, fyId, kind, invoiceNo])
  @@index([tenantId, firmId, fyId, kind])
  @@index([tenantId, partyId])
}

model InvoiceLr {
