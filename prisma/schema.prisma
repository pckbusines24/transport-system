  // salary structure (monthly)
  basicSalary Decimal @default(0) @db.Decimal(12, 2)
  allowances  Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model StaffAdvance {
