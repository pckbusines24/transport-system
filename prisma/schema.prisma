// ============ COURIER DISPATCH ============
// Standalone manual courier dispatch register — deliberately NOT linked to any
// master (party / vehicle / courier company are free-text). One dispatch holds
// unlimited vehicle/document rows, searchable by vehicle number.

model CourierDispatch {
  id             String    @id @default(cuid())
  tenantId       String
  firmId         String
  fyId           String
  dispatchNo     String // auto CDR-000001 per firm + FY
  dispatchDate   DateTime
  courierCompany String
  trackingNo     String? // AWB / tracking number
  partyName      String
  remarks        String?
  attachmentPath String? // courier slip / receipt (pdf / jpg / png)
  attachmentName String?

  items CourierDispatchItem[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([firmId, fyId, dispatchNo])
  @@index([tenantId, firmId, fyId, dispatchDate])
}

model CourierDispatchItem {
  id         String          @id @default(cuid())
  tenantId   String
  dispatchId String
  dispatch   CourierDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  vehicleNo       String
  documentDetails String
  remarks         String?

  @@index([tenantId, vehicleNo])
  @@index([dispatchId])
}

// ============ TYRE LIFE MANAGEMENT ============
// A Tyre is a permanent identity (unique tyre number). Its life is a series of
// installation cycles (vehicle + position + inst/removal KM). Transfers close
// one cycle and open the next; total life = sum of all cycle KMs / days.
// Tyre names are module-local free text (no product/master linkage).

model Tyre {
  id       String @id @default(cuid())
  tenantId String
  firmId   String
  tyreNo   String // permanent unique identity
  tyreName String // module-specific label, not a master
  status   String @default("RUNNING") // RUNNING | REMOVED

  cycles TyreCycle[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, firmId, tyreNo])
  @@index([tenantId, firmId, status])
}

model TyreCycle {
  id       String @id @default(cuid())
  tenantId String
  tyreId   String
  tyre     Tyre   @relation(fields: [tyreId], references: [id], onDelete: Cascade)

  vehicleId String
  position  String // HORSE | TRAILER
  entryDate DateTime
  instDate  DateTime
  instKm    Decimal  @db.Decimal(12, 1)

  removalDate   DateTime?
  removalKm     Decimal?  @db.Decimal(12, 1)
  removalReason String? // TRANSFER or free text on final removal
  remarks       String?

  createdAt DateTime @default(now())

  @@index([tenantId, tyreId])
  @@index([tenantId, vehicleId])
}

// ============ DRIVER MANAGEMENT ============
// Complete driver lifecycle: master + documents, vehicle assignment history,
// advances (source of truth for trip sheets), shortages, salary, and the
// +/- settlement register (auto vouchers on pay/receive). Every driver gets a
// linked Party (ledgerGroup DRIVER) so all money flows hit the normal ledger.

model Driver {
  id         String    @id @default(cuid())
  tenantId   String
  firmId     String
  driverCode String // auto DRV-0001
  partyId    String? // linked Party (DRIVER ledger)
  name       String
  mobile     String?
  emergencyContact String?
  address    String?
  joinDate   DateTime?
  exitDate   DateTime?
  exitReason String?
  status     String    @default("ACTIVE") // ACTIVE | INACTIVE
  remarks    String?

  // fixed document slots (path|name pairs)
  licencePath String?
  licenceName String?
  aadhaarPath String?
  aadhaarName String?
  panPath     String?
  panName     String?
  photoPath   String?
  photoName   String?
  medicalPath String?
  medicalName String?
  policePath  String?
  policeName  String?

  documents   DriverDocument[]
  assignments DriverAssignment[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([tenantId, firmId, driverCode])
  @@index([tenantId, firmId, status])
}

model DriverDocument {
  id       String @id @default(cuid())
  tenantId String
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  title    String
  filePath String
  fileName String
  createdAt DateTime @default(now())

  @@index([tenantId, driverId])
}

model DriverAssignment {
  id        String    @id @default(cuid())
  tenantId  String
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId String
  fromDate  DateTime
  toDate    DateTime?
  reason    String? // reason for vehicle change / exit
  remarks   String?
  createdAt DateTime @default(now())

  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
}

model DriverAdvance {
  id          String   @id @default(cuid())
  tenantId    String
  firmId      String
  fyId        String
  date        DateTime
  driverId    String
  vehicleId   String?
  tripRef     String? // optional trip reference no (manual)
  amount      Decimal  @default(0) @db.Decimal(14, 2)
  paymentMode String   @default("CASH") // CASH | BANK
  bankPartyId String? // bank/cash account paid from
  voucherRef  String? // payment voucher reference (manual)
  remarks     String?
  status      String   @default("PENDING") // PENDING | ADJUSTED
  tripId      String? // trip sheet that consumed this advance
  adjustedDate DateTime? // trip sheet finalization date

  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([tenantId, firmId, driverId, date])
  @@index([tenantId, tripId])
}

model DriverShortage {
  id       String   @id @default(cuid())
  tenantId String
  firmId   String
  fyId     String
  date     DateTime
  driverId String
  tripRef  String?
  amount   Decimal  @default(0) @db.Decimal(14, 2)
  adjustedAmount Decimal @default(0) @db.Decimal(14, 2) // partial adjustments accumulate here
  remarks  String?
  status   String   @default("PENDING") // PENDING | ADJUSTED
  salaryId String? // DriverSalary that adjusted it

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([tenantId, firmId, driverId, status])
}

// ============ SHORTAGE REGISTER ============
// One register for every shortage in the system, whatever module raised it.
// A shortage is a document with its own outstanding: it is RAISED against
// whoever is answerable for it, and every recovery links back and reduces it,
// so "created vs recovered vs pending" is answerable in one place.

model ShortageEntry {
  id       String   @id @default(cuid())
  tenantId String
  firmId   String
  fyId     String
  date     DateTime
  /** CHALAN | BROKER_SLIP | DRIVER | VOUCHER | MANUAL */
  module   String
  /** document that raised it, when it came from one */
  refId    String?
  refNo    String
  /** who is answerable — exactly one of these is set */
  partyId  String?
  driverId String?
  /** DRIVER | OWNER | BROKER | PARTY */
  partyKind String
  amount          Decimal @default(0) @db.Decimal(14, 2)
  recoveredAmount Decimal @default(0) @db.Decimal(14, 2)
  remarks  String?
  /** raised only to absorb a recovery that had nothing open to match — it is
   *  not a real shortage expense, so the shortage ledger skips it */
  autoRaised Boolean @default(false)

  recoveries ShortageRecovery[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, firmId, fyId])
  @@index([tenantId, partyId])
  @@index([tenantId, driverId])
  @@index([tenantId, module, refId])
}

model ShortageRecovery {
  id         String        @id @default(cuid())
  tenantId   String
  shortageId String
  shortage   ShortageEntry @relation(fields: [shortageId], references: [id], onDelete: Cascade)
  date       DateTime      @default(now())
  /** module that recovered it */
  module     String
  refId      String
  refNo      String
  /** DRIVER | OWNER | BROKER | PARTY | BANK */
  source     String
  /** who it was recovered FROM — may differ from the entry's own party */
  partyId    String?
  driverId   String?
  amount     Decimal       @default(0) @db.Decimal(14, 2)
  remarks    String?

  createdAt DateTime @default(now())

  @@index([tenantId, module, refId])
  @@index([shortageId])
}

model DriverSettlement {
  id        String   @id @default(cuid())
  tenantId  String
  firmId    String
  fyId      String
  date      DateTime
  driverId  String
  vehicleId String?
  tripId    String? // one settlement per trip
  tripRef   String? // trip no for display
  amount    Decimal  @default(0) @db.Decimal(14, 2) // + company pays driver, - driver pays company
  status    String   @default("PENDING") // PENDING | SETTLED
  settledDate DateTime?
  voucherId String? // auto-created payment/receipt voucher
  voucherNo String?
  remarks   String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([tenantId, tripId])
  @@index([tenantId, firmId, driverId, status])
}

model DriverSalary {
  id       String @id @default(cuid())
  tenantId String
  firmId   String
  fyId     String
  driverId String
  month    String // "YYYY-MM"

  salaryAmount      Decimal @default(0) @db.Decimal(12, 2)
  incentive         Decimal @default(0) @db.Decimal(12, 2)
  bonus             Decimal @default(0) @db.Decimal(12, 2)
  otherAllowance    Decimal @default(0) @db.Decimal(12, 2)
  advanceAdjust     Decimal @default(0) @db.Decimal(12, 2)
  shortageDeduction Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions   Decimal @default(0) @db.Decimal(12, 2)
  netPayable        Decimal @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal @default(0) @db.Decimal(12, 2) // partial payments accumulate here

  paymentStatus String    @default("PENDING") // PENDING | PAID
  paymentDate   DateTime?
  paymentHeadId String? // bank/cash party paid from
  remarks       String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([firmId, fyId, driverId, month])
  @@index([tenantId, driverId])
}

// ============ ADBLUE (UREA) STOCK ============
// Litre-only stock register: refills (in) and vehicle issues (out). No value,
// no accounting — the amount is computed only inside a trip sheet using a
// manually entered rate.

model AdblueTxn {
  id          String   @id @default(cuid())
  tenantId    String
  firmId      String
  fyId        String
  date        DateTime
  type        String // REFILL | ISSUE
  supplierName String? // refill only, free text when the supplier is not a party
  supplierId  String? // supplier party — required to book the purchase on credit
  vehicleId   String? // optional on refill, required on issue
  destination String? // issue only
  qty         Decimal  @default(0) @db.Decimal(12, 2) // litres
  // Bill details arrive a day or two after the stock does. Until they do the
  // refill is stock-only: quantity moves, nothing is posted, nothing is owed.
  amount      Decimal  @default(0) @db.Decimal(14, 2) // purchase value, once billed
  billNo      String?
  billDate    DateTime?
  gstPct      Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount   Decimal  @default(0) @db.Decimal(12, 2) // included in amount
  paymentMode String? // CASH | BANK — blank = on credit, settle later via voucher
  bankPartyId String? // paid from, when a payment mode is set
  refNo       String? // challan / bill no (informational)
  remarks     String?

  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([tenantId, firmId, fyId, type, date])
  @@index([tenantId, vehicleId, date])
}

// ============ VEHICLE EXPENSES (accounting) ============
// Office-I&E-style voucher with vehicle-wise allocation: one accounting
// voucher, unlimited vehicle rows. Relative-vehicle shares auto-transfer to
// the relative owner's ledger (company expense reduces). Trip sheets only
// FETCH (Diesel / Toll) from here — they never create expense records.

model VehicleExpenseVoucher {
  id        String @id @default(cuid())
  tenantId  String
  firmId    String
  fyId      String
  voucherNo String // auto VEX- (expense) / VIN- (income)
  date      DateTime // bill date
  paymentDate DateTime? // when cash/bank actually moved (may differ from bill date)
  txnType   String @default("EXPENSE") // EXPENSE | INCOME
  headId    String // AccountHead
  partyId   String? // supplier / party — optional
  paymentMode String? // CASH | BANK — blank = on credit
  bankPartyId String?
  amount    Decimal @default(0) @db.Decimal(14, 2) // total (>= sum of items; the rest is unallocated)
  // bulk purchases: what was bought and how many, so allocation can work in
  // quantities (3 of the 10 chains) rather than only in rupees
  itemName  String?
  qty       Decimal? @db.Decimal(12, 3)
  refNo     String?
  remarks   String?
  attachmentPath String?
  attachmentName String?

  items VehicleExpenseItem[]
  lines VehicleExpenseLine[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([firmId, fyId, voucherNo])
  @@index([tenantId, firmId, fyId, date])
}

// One vehicle's share of a purchase. A bulk purchase (10 chains for the stores)
// is booked with NO items and allocated later, one item per vehicle that
// actually consumed it — allocation moves cost between registers, never money,
// so it posts nothing to the ledger.
// One bill, many heads: optional head-wise split of a vehicle bill. The ledger
// debits each line's head; supplier/bank legs and vehicle allocation stay on
// the bill total; relative-owner transfers split proportionally across lines.
model VehicleExpenseLine {
  id        String                @id @default(cuid())
  tenantId  String
  voucherId String
  voucher   VehicleExpenseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  headId    String
  amount    Decimal               @default(0) @db.Decimal(14, 2)
  remarks   String?

  @@index([voucherId])
  @@index([tenantId])
}

model VehicleExpenseItem {
  id        String                @id @default(cuid())
  tenantId  String
  voucherId String
  voucher   VehicleExpenseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  vehicleId String
  amount    Decimal               @default(0) @db.Decimal(14, 2)
  // when this vehicle actually took the cost. Every vehicle-cost report reads
  // THIS date, not the purchase date, so a chain bought on the 1st and fitted on
  // the 8th does not distort the vehicle's P&L for the week in between.
  allocDate DateTime
  qty       Decimal?              @db.Decimal(12, 3)
  remarks   String?

  createdAt DateTime @default(now())

  @@index([tenantId, vehicleId])
  @@index([voucherId])
  @@index([tenantId, allocDate])
}

// ============ TALLY EXPORT ============

// One row per software-side concept/head/bank → the Tally ledger name the
// user typed on the Settings → Tally Mapping screen. Blank/missing mapping
// falls back to the software-side name (Tally auto-creates the ledger).
model TallyLedgerMap {
  id        String   @id @default(cuid())
  tenantId  String
  firmId    String
  module    String // CHALAN | BILLING | SLIP | HEAD | BANKCASH | ...
  sourceKey String // concept key ("freight_decl") or AccountHead/Party id
  tallyName String
  updatedAt DateTime @updatedAt

  @@unique([firmId, module, sourceKey])
  @@index([tenantId])
}

// Export register: which generated voucher (key) went out, with a content
// hash — so re-exports skip unchanged vouchers and flag edited documents.
model TallyExportEntry {
  id         String   @id @default(cuid())
  tenantId   String
  firmId     String
  key        String // e.g. "CHALAN:<id>:MAIN"
  hash       String
  exportedAt DateTime @default(now())

  @@unique([firmId, key])
  @@index([tenantId])
}

// ============ VEHICLE TRACKING (live register) ============
// One snapshot row per vehicle per day, auto-saved on every edit (no save
// button). Latest row = current live status; older rows = date-wise history.
// Retention: only the last 120 days are kept (auto-cleanup, this module only).

model VehicleTracking {
  id              String   @id @default(cuid())
  tenantId        String
  firmId          String
  vehicleId       String
  date            DateTime // normalized to the day of the update
  transporterName String?
  fromLocation    String?
  toLocation      String?
  currentLocation String?
  status          String?
  remarks         String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, firmId, vehicleId, date])
  @@index([tenantId, firmId, date])
}

// ============ TRIP SETTLEMENT LINKS ============
// A chalan / broker slip can be settled in exactly ONE trip sheet — the
// unique(refType, refId) makes "pending" enforcement structural.

model TripDoc {
  id       String @id @default(cuid())
  tenantId String
  tripId   String
  refType  String // CHALAN | BROKER_SLIP
  refId    String

  createdAt DateTime @default(now())

  @@unique([tenantId, refType, refId])
  @@index([tripId])
}

// ============ DRIVER FINAL SETTLEMENT (F&F) ============
// One-time full & final settlement when a driver leaves: settles running
// salary, shortages, pending advances and the +/- negative balance in a
// single locked document with its own settlement number.

model DriverFnf {
  id           String   @id @default(cuid())
  tenantId     String
  firmId       String
  fyId         String
  settlementNo String // auto DFS-0001
  driverId     String
  date         DateTime
  lastWorkingDate DateTime?

  grossSalary       Decimal @default(0) @db.Decimal(14, 2) // running salary outstanding
  shortageAdjust    Decimal @default(0) @db.Decimal(14, 2)
  advanceAdjust     Decimal @default(0) @db.Decimal(14, 2)
  negativeAdjust    Decimal @default(0) @db.Decimal(14, 2) // driver +/- negative balance recovered
  otherRecoveries   Decimal @default(0) @db.Decimal(14, 2)
  otherPayments     Decimal @default(0) @db.Decimal(14, 2) // incentives / bonuses
  finalPayable      Decimal @default(0) @db.Decimal(14, 2) // +pay driver / −receive from driver

  paymentMode String? // CASH | BANK
  bankPartyId String?
  refNo       String?
  remarks     String?

  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@unique([firmId, fyId, settlementNo])
  // one F&F per driver, EVER — closes the race where two concurrent
  // finalizations both passed the findFirst existence check
  @@unique([driverId])
  @@index([tenantId, driverId])
}

// ============ PARTY ADVANCES ============
// Money received without (or beyond) an outstanding reference. Created
// automatically by receipt vouchers (unallocated remainder / over-payment)
// and consumed later by bills. Balance = amount - consumedAmount.

model PartyAdvance {
  id             String   @id @default(cuid())
  tenantId       String
  firmId         String
  fyId           String
  partyId        String
  kind           String   @default("RECEIVED") // RECEIVED (from party) | PAID (to party)
  date           DateTime
  voucherId      String? // receipt/payment voucher that created it
  voucherNo      String?
  // VOUCHER (default) | CHALAN_CANCEL — cancel-created advances live in their
  // own register but stay adjustable everywhere like any other open advance
  source         String   @default("VOUCHER")
  sourceRefId    String? // cancelled chalan id
  amount         Decimal  @default(0) @db.Decimal(14, 2)
  consumedAmount Decimal  @default(0) @db.Decimal(14, 2)
  remarks        String?

  uses           PartyAdvanceUse[]
  chalanAdvances ChalanAdvance[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([tenantId, firmId, partyId])
  @@index([tenantId, voucherId])
}

model PartyAdvanceUse {
  id        String       @id @default(cuid())
  tenantId  String
  advanceId String
  advance   PartyAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  refType   String // INVOICE | ...
  refId     String
  refNo     String
  amount    Decimal      @default(0) @db.Decimal(14, 2)
  date      DateTime     @default(now())

  @@index([tenantId, refType, refId])
  @@index([advanceId])
}
