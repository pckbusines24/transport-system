  tenantId       String
  firmId         String
  date           DateTime
  productGroupId String?
  productId      String
  qty            Decimal   @default(0) @db.Decimal(12, 3)
  rate           Decimal   @default(0) @db.Decimal(12, 2)
  partNo         String?
  wrntyExpDate   DateTime?
  remarks        String?

  @@index([tenantId])
}

model StationeryStock {
