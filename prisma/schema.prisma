model StaffSalary {
  id       String @id @default(cuid())
  tenantId String
  firmId   String
  fyId     String
  partyId  String
  month    String // "YYYY-MM"

  // earnings
  basic         Decimal @default(0) @db.Decimal(12, 2)
  allowances    Decimal @default(0) @db.Decimal(12, 2)
  overtime      Decimal @default(0) @db.Decimal(12, 2)
  incentives    Decimal @default(0) @db.Decimal(12, 2)
  bonus         Decimal @default(0) @db.Decimal(12, 2)
  otherEarnings Decimal @default(0) @db.Decimal(12, 2)

  // deductions
  attendanceAdj   Decimal @default(0) @db.Decimal(12, 2) // attendance adjustment (−)
  leaveDeduction  Decimal @default(0) @db.Decimal(12, 2)
  penalties       Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal @default(0) @db.Decimal(12, 2)
  advanceId       String? // StaffAdvance recovered against
  advanceRecovery Decimal @default(0) @db.Decimal(12, 2)
  loanId          String? // StaffLoan recovered against
