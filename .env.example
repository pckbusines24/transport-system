# Local dev (docker-compose Postgres on port 5433)
DATABASE_URL="postgresql://app_user:app_dev_password@localhost:5433/transport_tms?schema=public"
DIRECT_DATABASE_URL="postgresql://tms:tms_dev_password@localhost:5433/transport_tms?schema=public"

# ---- Hosted DB: DigitalOcean Managed PostgreSQL (Bangalore) ----
# TWO different strings from the same cluster, and they are not interchangeable:
#
#   DATABASE_URL         the CONNECTION POOL (Databases -> Connection Pools,
#                        mode "Transaction"). PgBouncer in transaction mode does
#                        not keep prepared statements between statements, so the
#                        pgbouncer=true flag is required — without it you get
#                        intermittent 'prepared statement "s0" does not exist'.
#   DIRECT_DATABASE_URL  the DIRECT connection (port 25060). Migrations need a
#                        real session, so they must not go through the pool.
#
# sslmode=require is required by DO. Use `require`, not `verify-full`, unless
# you also ship DO's CA certificate and point sslrootcert at it.
# DATABASE_URL="postgresql://<user>:<pw>@<host>:25061/<db>?sslmode=require&pgbouncer=true&connection_limit=10"
# DIRECT_DATABASE_URL="postgresql://<user>:<pw>@<host>:25060/<db>?sslmode=require"

AUTH_SECRET="change-me"
NEXT_PUBLIC_APP_NAME="TransportTMS"

# ---- File storage -----------------------------------------------------------
# STORAGE_DRIVER picks the backend explicitly, so the production cutover is a
# deliberate flip and the rollback is the same flip in reverse:
#
#   disk  (default)  files under UPLOAD_DIR — development, and the old behaviour
#   s3               any S3-compatible store: Cloudflare R2, AWS S3, Spaces, MinIO
#
# Object keys are IDENTICAL under both drivers (<tenantId>/<kind>/<uuid>.<ext>)
# and are what the database already stores, so switching needs no data
# migration — only that the bytes be copied across.
STORAGE_DRIVER="disk"
UPLOAD_DIR="./data/uploads"          # disk driver only

# Cloudflare R2 (10 GB free, and no egress charge — which is what makes it
# sensible to proxy every read through the authenticated app route):
# STORAGE_DRIVER="s3"
# S3_BUCKET="transport-tms-uploads"
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
#
# On AWS S3: omit S3_ENDPOINT, set a real S3_REGION, and omit both keys to pick
# up an instance/role credential instead of storing secrets.
